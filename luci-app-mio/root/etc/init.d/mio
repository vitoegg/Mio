#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

PROG="/usr/bin/mio"
CONF="/var/etc/mio.json"
LOG_FILE="/tmp/log/mio.log"
CHECK_ONLY=0
FIREWALL_PORT=

# Same format as the messages of mio.
log() {
	echo "$(date '+%Y-%m-%d %H:%M:%S') [ERROR] $1" >> "$LOG_FILE"
}

validate_section() {
	uci_load_validate mio mio "$1" "$2" \
		'enabled:bool:0' \
		'port:range(1024,65535):6160' \
		'password:string' \
		'cipher:or("2022-blake3-aes-128-gcm","2022-blake3-aes-256-gcm","2022-blake3-chacha20-poly1305"):2022-blake3-aes-128-gcm' \
		'open_firewall:bool:0' \
		'log_level:or("warning","info"):warning'
}

open_port() {
	local zone

	# Open the port in the zone that holds the IPv4 default route (wan on a main router, lan on a bypass router).
	zone=$(. /lib/functions/network.sh && network_find_wan wan && fw4 -q network "$wan") || {
		log "Unable to detect the firewall zone; port not opened"
		return 0
	}

	json_add_array firewall
	json_add_object ""
	json_add_string type rule
	json_add_string name Allow-Mio
	json_add_string src "$zone"
	json_add_string proto "tcp udp"
	json_add_string dest_port "$FIREWALL_PORT"
	json_add_string target ACCEPT
	json_close_object
	json_close_array
}

start_server() {
	[ "$2" = 0 ] || {
		log "Invalid settings"
		return 1
	}
	[ "$enabled" = 1 ] || return 0

	json_init
	json_add_int port "$port"
	json_add_string password "$password"
	json_add_string cipher "$cipher"
	# mio reports invalid settings in the log itself.
	json_dump | "$PROG" -t -c /dev/stdin -o "$LOG_FILE" || return 1
	[ "$CHECK_ONLY" = 1 ] && return 0

	(umask 077 && json_dump > "$CONF") && chown mio "$CONF" || {
		log "Failed to write $CONF"
		return 1
	}

	procd_open_instance mio
	procd_set_param command "$PROG" -c "$CONF" -l "$log_level" -o "$LOG_FILE"
	procd_set_param user mio
	# Each relayed connection takes two descriptors.
	procd_set_param limits nofile="65536 65536"
	# Only a panic writes to stderr.
	procd_set_param stderr 1
	procd_set_param respawn
	procd_set_param file "$CONF"
	# Validated options are local to this callback; keep the port for service_data.
	[ "$open_firewall" = 1 ] && FIREWALL_PORT=$port
	procd_close_instance
}

# Firewall rules are service data rather than instance data: procd then notifies fw4 on every
# change, including removal, even when the instance is restarted at the same time.
service_data() {
	[ -n "$FIREWALL_PORT" ] && open_port
}

start_service() {
	# mio runs as its own user and appends to the log file.
	mkdir -p "${CONF%/*}" "${LOG_FILE%/*}" && touch "$LOG_FILE" && chmod 600 "$LOG_FILE" && chown mio "$LOG_FILE" || return 1
	validate_section main start_server
}

reload_service() {
	# rc.common submits the service even when start_service fails, so validate
	# first to keep the running instance when the new configuration is invalid.
	CHECK_ONLY=1
	start_service || return 1
	CHECK_ONLY=0
	start
}

service_triggers() {
	local enabled open_firewall

	procd_add_reload_trigger "mio"
	procd_add_validation validate_section

	config_load mio
	config_get_bool enabled main enabled 0
	config_get_bool open_firewall main open_firewall 0
	# Re-detect the firewall zone when interfaces change; unchanged settings do not restart mio.
	if [ "$enabled" = 1 ] && [ "$open_firewall" = 1 ]; then
		procd_add_raw_trigger "interface.*" 3000 /etc/init.d/mio reload
	fi
}
