#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

PROG="/usr/bin/snell-server"
CONF="/var/etc/mio.conf"
CHECK_ONLY=0
FIREWALL_PORT=

log() {
	logger -t mio -p daemon.err "$1"
}

is_psk_valid() {
	# snell-server trims config values, so surrounding whitespace would silently change the key.
	case "$1" in
		[[:space:]]*|*[[:space:]]|*[[:cntrl:]]*) return 1 ;;
	esac
}

validate_section() {
	uci_load_validate mio mio "$1" "$2" \
		'enabled:bool:0' \
		'server_port:range(1024,65535):6160' \
		'psk:string' \
		'open_firewall:bool:0' \
		'log_level:or("notify","info"):notify' \
		'server:ipaddr:0.0.0.0' \
		'obfs:or("off","http"):http' \
		'ipv6:bool:1'
}

write_config() {
	local ipv6_value=false

	[ "$ipv6" = 1 ] && ipv6_value=true
	mkdir -p "${CONF%/*}" &&
	(umask 077 && printf '[snell-server]\nlisten = %s:%s\npsk = %s\nipv6 = %s\nobfs = %s\n' \
		"$server" "$server_port" "$psk" "$ipv6_value" "$obfs" > "$CONF") &&
	chown nobody "$CONF"
}

open_port() {
	local zone

	# Open the port in the zone that holds the IPv4 default route (wan on a main router, lan on a bypass router).
	zone=$(. /lib/functions/network.sh && network_find_wan wan && fw4 -q network "$wan") || {
		log "Unable to detect the firewall zone; port not opened"
		return 0
	}

	json_add_array firewall
	json_add_object ""
	json_add_string type rule
	json_add_string name "Allow-Mio"
	json_add_string src "$zone"
	# snell-server serves its QUIC proxy on the same UDP port.
	json_add_string proto "tcp udp"
	json_add_string dest_port "$FIREWALL_PORT"
	json_add_string target ACCEPT
	json_close_object
	json_close_array
}

start_server() {
	[ "$2" = 0 ] || {
		log "Invalid settings"
		return 1
	}
	[ "$enabled" = 1 ] || return 0
	[ -n "$psk" ] || {
		log "PSK is required"
		return 1
	}
	is_psk_valid "$psk" || {
		log "Invalid PSK: remove leading or trailing whitespace and control characters"
		return 1
	}
	[ "$CHECK_ONLY" = 1 ] && return 0

	write_config || {
		log "Failed to write $CONF"
		return 1
	}

	procd_open_instance mio
	procd_set_param command "$PROG" -c "$CONF" -l "$log_level"
	procd_set_param user nobody
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_set_param file "$CONF"
	# Validated options are local to this callback; keep the port for service_data.
	[ "$open_firewall" = 1 ] && FIREWALL_PORT=$server_port
	procd_close_instance
}

# Firewall rules are service data rather than instance data: procd then notifies fw4 on every
# change, including removal, even when the instance is restarted at the same time.
service_data() {
	[ -n "$FIREWALL_PORT" ] && open_port
}

start_service() {
	validate_section main start_server
}

reload_service() {
	# rc.common submits the service even when start_service fails, so validate
	# first to keep the running instance when the new configuration is invalid.
	CHECK_ONLY=1
	start_service || return 1
	CHECK_ONLY=0
	start
}

service_triggers() {
	local enabled open_firewall

	procd_add_reload_trigger "mio"
	procd_add_validation validate_section

	config_load mio
	config_get_bool enabled main enabled 0
	config_get_bool open_firewall main open_firewall 0
	# Re-detect the firewall zone when interfaces change; unchanged settings do not restart snell-server.
	if [ "$enabled" = 1 ] && [ "$open_firewall" = 1 ]; then
		procd_add_raw_trigger "interface.*" 3000 /etc/init.d/mio reload
	fi
}
