#!/bin/sh /etc/rc.common

# Start before mio: logread only receives messages logged after it subscribes.
START=50
USE_PROCD=1

LOG_FILE="/tmp/log/mio.log"

start_service() {
	mkdir -p "${LOG_FILE%/*}"

	# logread rotates to $LOG_FILE.old above 64 KiB.
	procd_open_instance
	procd_set_param command /sbin/logread -f -F "$LOG_FILE" -S 64 -e '^\(mio\|snell-server\)[:[]'
	procd_set_param respawn
	procd_close_instance
}
